      <column caption='case statement' datatype='string' name='[Calculation_1802153026752515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Segment]&#13;&#10;WHEN &quot;consumer&quot; THEN &quot;C&quot;&#13;&#10;WHEN &quot;corparate&quot; THEN &quot; B&quot;&#13;&#10;ELSE &quot;other&quot; END' />
